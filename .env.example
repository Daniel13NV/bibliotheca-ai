# ============================================================
#  Bibliotheca AI — variables de entorno (copiar a .env)
# ============================================================
TZ=America/Mexico_City

# Seguridad
INTERNAL_API_KEY=bibliotheca-internal-key-cambiar
JWT_SECRET=bibliotheca-jwt-secret-cambiar-por-uno-largo
JWT_EXPIRES_IN=8h

# MySQL (una base por microservicio)
MYSQL_ROOT_PASSWORD=rootpass
DB_PASSWORD=bibliotheca123

# RabbitMQ
RABBITMQ_USER=bibliotheca
RABBITMQ_PASSWORD=bibliotheca123

# IA local (Ollama). Si instalaste Ollama en Windows, puedes usar:
# OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Telegram (créalo con @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=BibliothecaAIBot
# Chat (grupo o usuario) que recibe alertas de seguridad del arco RFID
LIBRARY_ALERTS_CHAT_ID=

# Políticas de préstamo
LOAN_DAYS_STUDENT=7
LOAN_DAYS_STAFF=14
MAX_ACTIVE_LOANS_STUDENT=3
MAX_RENEWALS=2
RENEWAL_DAYS=7
DAILY_FINE=5
MAX_FINE_PER_LOAN=150

# RFID
RFID_DEDUP_WINDOW_MS=5000
